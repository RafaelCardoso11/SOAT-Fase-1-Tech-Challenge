%% C4 Nível 3 - Componentes da API Monolítica. Feito como flowchart (e não C4Component) para importar no Miro.
%% Ligações entre camadas (e não entre cada componente) para o diagrama não virar um emaranhado de setas.
flowchart TB
    USR["Cliente / Atendente / Mecânico"]

    subgraph API["API Monolítica - Contêiner Docker"]
        direction TB

        subgraph CTRL["Controllers - REST + Swagger"]
            direction LR
            AUTH["Filtro JWT"]
            C1["OrdemServicoController"]
            C2["OrcamentoController"]
            C3["ClienteController"]
            C4["VeiculoController"]
            C5["ServicoController"]
            C6["PecaController"]
        end

        subgraph UC["Use Cases"]
            direction LR
            U1["CriarOrdemServico"]
            U2["RealizarDiagnostico"]
            U3["GerarOrcamento"]
            U4["ReservarPeca"]
            U5["Aprovar / Rejeitar / Revisar Orcamento"]
            U6["ExpirarOrcamento - agendado"]
            U7["Iniciar / Finalizar Execucao"]
            U8["EntregarVeiculo"]
            U9["ConsultarStatusOS"]
            U10["CRUD Cliente / Veiculo / Servico / Peca"]
        end

        subgraph DOM["Domain - Entities e Domain Services"]
            direction LR
            E1["OrdemServico - agregado"]
            E2["Diagnostico"]
            E3["Orcamento"]
            E4["Peca / Estoque"]
            E5["Cliente"]
            E6["Veiculo"]
            DS1["CalculoOrcamento"]
            DS2["ValidadorDocumento - CPF, CNPJ, placa"]
        end

        subgraph REPO["Repositories"]
            direction LR
            R1["OrdemServicoRepository"]
            R2["OrcamentoRepository"]
            R3["PecaRepository"]
            R4["ClienteRepository"]
            R5["VeiculoRepository"]
            R6["ServicoRepository"]
        end

        NOTC["NotificacaoGateway"]
    end

    DB[("Banco de Dados")]
    NOT["Serviço de Notificação - Sistema Externo"]

    USR -- "HTTPS/JSON" --> CTRL
    CTRL -- "chama" --> UC
    UC -- "usa" --> DOM
    UC -- "persiste via" --> REPO
    UC -- "notifica via" --> NOTC
    REPO -- "lê e grava" --> DB
    NOTC -- "HTTPS" --> NOT

    classDef pessoa fill:#08427B,stroke:#052E56,color:#fff
    classDef componente fill:#85BBF0,stroke:#5D82A8,color:#000
    classDef externo fill:#999999,stroke:#6B6B6B,color:#fff
    classDef banco fill:#438DD5,stroke:#2E6295,color:#fff
    class USR pessoa
    class AUTH,C1,C2,C3,C4,C5,C6,U1,U2,U3,U4,U5,U6,U7,U8,U9,U10,E1,E2,E3,E4,E5,E6,DS1,DS2,R1,R2,R3,R4,R5,R6,NOTC componente
    class DB banco
    class NOT externo
