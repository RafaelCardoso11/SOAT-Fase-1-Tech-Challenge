%% C4 Nível 3 - Componentes da API Oficina. Feito como flowchart (e não C4Component) para importar no Miro.
%% Um subgraph por bounded context; dentro dele, as camadas hexagonais. Só as ligações entre camadas e
%% entre contextos aparecem, para o diagrama não virar um emaranhado de setas.
flowchart TB
    USR["Cliente / Atendente / Mecânico"]

    subgraph API["API Oficina - Contêiner Docker (módulo bootstrap)"]
        direction TB

        SEC["SecurityConfig + JwtAuthenticationFilter - rotas públicas e protegidas"]

        subgraph AUTH["autenticacao - genérico"]
            direction TB
            A_IN["AutenticacaoController - POST /api/auth/login"]
            A_UC["AutenticarService"]
            A_OUT["UsuarioRepositoryAdapter, JwtTokenProvider, BCryptCodificadorDeSenha"]
        end

        subgraph OS["ordemservico - principal"]
            direction TB
            O_IN["OrdemServico, Diagnostico, Orcamento, Aprovar, Rejeitar e RevisarOrcamento, Execucao, Entrega, Relatorio e Expiracao Controllers, ConsultarOrdensController (público), ExpiracaoScheduler"]
            O_UC["CriarOrdemServico, RealizarDiagnostico, GerarOrcamento, Aprovar, Rejeitar, Revisar e ExpirarOrcamentos, Iniciar e FinalizarExecucao, EntregarVeiculo, ConsultarOrdens, ConsultarTempoMedioExecucao"]
            O_DOM["OrdemServico (agregado), Orcamento, ItemOrcamento, StatusOS, TransicaoStatus, eventos de domínio"]
            O_OUT["OrdemServicoRepositoryAdapter, PublicadorDeEventosSpring, NotificacaoPorEmail, EstoqueAdapter (ACL da EstoquePort)"]
        end

        subgraph CAD["cadastro - suporte"]
            direction TB
            C_IN["Cliente, Veiculo e Servico Controllers"]
            C_UC["Gerenciar e Consultar Cliente, Veiculo e Servico"]
            C_OUT["Cliente, Veiculo e Servico RepositoryAdapters"]
        end

        subgraph EST["estoque - suporte"]
            direction TB
            E_IN["ItemEstoqueController"]
            E_UC["GerenciarItem, ConsultarItem, ReservarPeca, LiberarReserva, BaixarPecas, ConsultarReservas"]
            E_OUT["ItemEstoqueRepositoryAdapter (lock pessimista)"]
        end

        SK["shared-kernel - Documento, Placa, Dinheiro, DomainEvent"]
    end

    DB[("PostgreSQL - um schema por módulo")]
    MAIL["Servidor SMTP - Mailpit em dev"]

    USR -- "HTTPS/JSON" --> SEC
    SEC --> A_IN & O_IN & C_IN & E_IN
    A_IN --> A_UC --> A_OUT
    O_IN --> O_UC --> O_DOM
    O_UC --> O_OUT
    C_IN --> C_UC --> C_OUT
    E_IN --> E_UC --> E_OUT
    O_OUT -- "reserva, libera e baixa peças (in-process, síncrono)" --> E_UC
    O_OUT -- "SMTP" --> MAIL
    A_OUT & O_OUT & C_OUT & E_OUT -- "JPA / JDBC" --> DB
    O_DOM & C_UC & E_UC -. "usa VOs" .-> SK

    classDef pessoa fill:#08427B,stroke:#052E56,color:#fff
    classDef componente fill:#85BBF0,stroke:#5D82A8,color:#000
    classDef transversal fill:#C5DCF5,stroke:#5D82A8,color:#000
    classDef externo fill:#999999,stroke:#6B6B6B,color:#fff
    classDef banco fill:#438DD5,stroke:#2E6295,color:#fff
    class USR pessoa
    class A_IN,A_UC,A_OUT,O_IN,O_UC,O_DOM,O_OUT,C_IN,C_UC,C_OUT,E_IN,E_UC,E_OUT componente
    class SEC,SK transversal
    class DB banco
    class MAIL externo
