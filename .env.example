# Copie para .env e ajuste os valores. O .env NÃO deve ser versionado (ver .gitignore).

# ---- PostgreSQL ----
POSTGRES_DB=oficina
POSTGRES_USER=oficina
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ---- Aplicação (Spring Boot) ----
APP_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/oficina
SPRING_DATASOURCE_USERNAME=oficina
SPRING_DATASOURCE_PASSWORD=change-me

# ---- Autenticação (JWT) ----
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRATION_MINUTES=60

# ---- Notificação por e-mail (SMTP / Mailpit em dev) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
NOTIFICACAO_EMAIL_ENABLED=false
NOTIFICACAO_EMAIL_REMETENTE=oficina@exemplo.com
NOTIFICACAO_EMAIL_DESTINATARIO=cliente@exemplo.com
# Base dos links enviados ao cliente no e-mail do orçamento
NOTIFICACAO_URL_BASE=http://localhost:8080

# ---- Orçamento ----
ORCAMENTO_VALIDADE_DIAS=7
